{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Servo",
  "version": "1.0.0",
  "identifier": "com.servo.services",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1423",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Servo",
        "width": 1320,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 640,
        "resizable": true,
        "decorations": false,
        "visible": false,
        "center": true,
        "label": "main",
        "backgroundColor": "#16171b",
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection,OptimizationHints,Translate,MediaRouter --disable-component-update --disable-background-networking --disable-sync --disable-gpu-shader-disk-cache --disk-cache-size=1 --media-cache-size=1 --no-first-run --no-default-browser-check"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "languages": ["Russian", "English"],
        "displayLanguageSelector": false,
        "installMode": "perMachine"
      }
    }
  }
}
